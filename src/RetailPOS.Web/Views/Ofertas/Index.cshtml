@model List<Oferta>
@{ ViewData["Title"] = "Ofertas"; var hoy = RetailPOS.Infrastructure.Precios.HoyChile; }
<div class="eyebrow">PROMOCIONES</div>
<h1>Ofertas por marca, talla y SKU</h1>
<p class="muted">Selecciona uno o más filtros. Si combinas marca y talla, deben cumplirse ambos. Las ofertas no se acumulan: se aplica la que deje el menor precio. Vigencia por día de Chile, con inicio y fin incluidos.</p>
<section class="card"><h2>Nueva oferta</h2>
<form asp-action="Crear" method="post">
    <label>Nombre<input name="Nombre" maxlength="120" required placeholder="Semana de ofertas" /></label>
    <div class="fields">
        <label>Marca<select name="MarcaId"><option value="">Cualquier marca</option>
        @foreach (var m in (List<Marca>)ViewBag.Marcas)
        {
            <option value="@m.Id">@m.Nombre</option>
        }
        </select></label>
        <label>Talla<select name="TallaId"><option value="">Cualquier talla</option>
        @foreach (var t in (List<TallaCalzado>)ViewBag.Tallas)
        {
            <option value="@t.Id">@t.Sistema @t.Valor</option>
        }
        </select></label>
        <label>SKU<select name="VarianteId"><option value="">Cualquier SKU</option>
        @foreach (var v in (List<Variante>)ViewBag.Variantes)
        {
            <option value="@v.Id">@v.Sku · @v.Color · @v.SistemaTalla @v.Talla</option>
        }
        </select></label>
    </div>
    <div class="fields">
        <label>Descuento<select name="Tipo"><option value="Porcentaje">Porcentaje (%)</option><option value="Monto">Monto fijo por unidad (CLP)</option></select></label>
        <label>Valor<input name="Valor" type="number" min="0.01" max="999999999" step="0.01" required /></label>
        <label>Desde<input name="Inicio" type="date" value="@hoy.ToString("yyyy-MM-dd")" required /></label>
        <label>Hasta<input name="Fin" type="date" value="@hoy.AddDays(7).ToString("yyyy-MM-dd")" required /></label>
    </div>
    <p class="muted">Porcentaje hasta 100%. Monto fijo en pesos enteros. El precio final mínimo es $1, redondeado a pesos.</p>
    <button>Crear oferta</button>
</form></section>
<div class="table-wrap"><table><thead><tr><th>Oferta</th><th>Filtros</th><th>Descuento</th><th>Vigencia</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var o in Model)
{
    <tr><td>@o.Nombre</td><td>@(o.Marca?.Nombre ?? "Todas las marcas")<br />@(o.Talla is null ? "Todas las tallas" : o.Talla.Sistema + " " + o.Talla.Valor)<br />@(o.Variante?.Sku ?? "Todos los SKU")</td><td>@(o.Tipo == "Porcentaje" ? o.Valor.ToString("0.##") + "%" : "$" + o.Valor.ToString("N0"))</td><td>@o.Inicio.ToString("dd/MM/yyyy") — @o.Fin.ToString("dd/MM/yyyy")</td><td>@(!o.Activa ? "Desactivada" : hoy < o.Inicio ? "Programada" : hoy > o.Fin ? "Vencida" : "Vigente")</td><td>
    <form asp-action="Estado" method="post"><input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="activa" value="@((!o.Activa).ToString().ToLowerInvariant())" /><button class="secondary">@(o.Activa ? "Desactivar" : "Activar")</button></form>
    </td></tr>
}
</tbody></table>
@if (Model.Count == 0)
{
    <p class="empty">Aún no hay ofertas. Crea marcas, tallas y variantes para comenzar.</p>
}
</div>


