@model Cliente
@{ ViewData["Title"]="Editar cliente"; }
<h1>Editar cliente</h1><section class="card"><form method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="fields"><label>Nombre<input asp-for="Nombre" required/></label><label>RUT<input asp-for="Rut"/></label><label>Giro<input asp-for="Giro"/></label><label>Dirección<input asp-for="Direccion"/></label><label>Comuna<input asp-for="Comuna"/></label></div><button>Guardar cliente</button></form></section>
