@model List<Cliente>
<form method="get" class="fields"><label>Buscar cliente<input name="q" value="@ViewBag.Q"/></label><button>Buscar</button></form>
@{ ViewData["Title"] = "Clientes"; }
<div class="eyebrow">CLIENTES</div>
<h1>Personas y empresas</h1>
<section class="card">
<h2>Nuevo cliente</h2>
<form asp-action="Crear" method="post">
<div class="fields">
<label>Nombre o razón social<input name="Nombre" required maxlength="150" />
</label>
<label>RUT<input name="Rut" maxlength="12" placeholder="12345678-5" />
</label>
<label>Giro<input name="Giro" maxlength="150" />
</label>
<label>Dirección<input name="Direccion" maxlength="200" />
</label>
<label>Comuna<input name="Comuna" maxlength="100" />
</label>
</div>
<button>Guardar cliente</button>
</form>
</section>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Nombre</th>
<th>RUT</th>
<th>Giro</th>
<th>Dirección</th>
</tr>
</thead>
<tbody>
@foreach (var c in Model)
{
<tr>
<td>
@c.Nombre</td>
<td>
@c.Rut</td>
<td>
@c.Giro</td>
<td>
@c.Direccion @c.Comuna</td>
<td><a asp-action="Editar" asp-route-id="@c.Id">Editar</a></td>
</tr>
}
</tbody>
</table>
@if (Model.Count == 0)
{
<p class="empty">Todavía no hay clientes registrados.</p>
}
</div>
<p>Página @ViewBag.Pagina · @ViewBag.Total clientes</p>
@if(ViewBag.Pagina>1){<a asp-route-pagina="@(ViewBag.Pagina-1)" asp-route-q="@ViewBag.Q">Anterior</a>}
@if(ViewBag.Pagina*50<ViewBag.Total){<a asp-route-pagina="@(ViewBag.Pagina+1)" asp-route-q="@ViewBag.Q">Siguiente</a>}


