@model Compra
@{ ViewData["Title"]="Compra "+Model.Id; }
<h1>Compra #@Model.Id</h1><p>@Model.Proveedor.Nombre · @Model.Referencia · @Model.Bodega.Nombre · @Model.Fecha.ToString("dd/MM/yyyy HH:mm") UTC</p>
<div class="table-wrap"><table><thead><tr><th>SKU</th><th>Cantidad</th><th>Costo unitario</th><th>Total</th></tr></thead><tbody>@foreach(var l in Model.Detalles){<tr><td>@l.Variante.Sku</td><td>@l.Cantidad</td><td>$@l.CostoUnitario.ToString("N2")</td><td>$@((l.Cantidad*l.CostoUnitario).ToString("N2"))</td></tr>}</tbody></table></div><p class="total">$@Model.Total.ToString("N2")</p>
