<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Evita resultados inconsistentes del proceso compartido de Razor en este entorno. -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../RetailPOS.Application/RetailPOS.Application.csproj" />
    <ProjectReference Include="../RetailPOS.Infrastructure/RetailPOS.Infrastructure.csproj" />
  </ItemGroup>
</Project>

